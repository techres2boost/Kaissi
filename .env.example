# ─── Supabase (partagé) ───────────────────────────────────────────────────────
SUPABASE_URL=https://mzrbpbqpkpbbndtijipw.supabase.co
SUPABASE_ANON_KEY=
# JAMAIS dans le bundle du POS. Serveur uniquement.
SUPABASE_SERVICE_ROLE_KEY=

# ─── API de synchronisation (apps/sync) ───────────────────────────────────────
DATABASE_URL=postgresql://postgres:motdepasse@db.mzrbpbqpkpbbndtijipw.supabase.co:5432/postgres
SYNC_PORT=8787
# Secret de signature des jetons d'appareil (HS256). À générer : openssl rand -hex 32
DEVICE_TOKEN_SECRET=

# ─── Back-office (apps/backoffice) ────────────────────────────────────────────
# Deux variables, pas une de plus. Le back-office n'utilise QUE la clé
# publique : c'est RLS qui cloisonne, pas des « where » écrits à la main.
# Coller ici la clé service_role empêche l'application de démarrer — un
# contrôle explicite la refuse (src/serveur/supabase.ts).
#
# Où les trouver : Supabase → bouton « Connect » en haut → App Frameworks.
NEXT_PUBLIC_SUPABASE_URL=https://mzrbpbqpkpbbndtijipw.supabase.co
# Clé « anon » (eyJ…) ou « publishable » (sb_publishable_…), au choix.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── POS (apps/pos) ───────────────────────────────────────────────────────────
# Le POS ne connaît QUE l'URL de l'API de sync. Aucune clé Supabase embarquée.
VITE_SYNC_API_URL=http://localhost:8787
