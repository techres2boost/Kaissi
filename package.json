{
  "name": "kaissi",
  "private": true,
  "version": "0.1.0",
  "description": "Kaissi — POS & gestion de restaurant offline-first (Res2Boost)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:rapide": "turbo run test --filter=@kaissi/domain --filter=@kaissi/db-local --filter=@kaissi/printing",
    "db:test": "bash ./scripts/postgres-test.sh",
    "db:test:stop": "bash ./scripts/postgres-test.sh --stop",
    "test:domain": "pnpm --filter @kaissi/domain test",
    "lint": "turbo run lint",
    "pos:dev": "pnpm --filter @kaissi/pos dev",
    "pos:dev:web": "pnpm --filter @kaissi/pos dev:web",
    "pos:build": "pnpm --filter @kaissi/pos build",
    "pos:build:web": "pnpm --filter @kaissi/pos build:web",
    "pos:build:impression": "pnpm --filter @kaissi/pos build:impression",
    "pos:build:web:impression": "pnpm --filter @kaissi/pos build:web:impression",
    "pos:android": "pnpm --filter @kaissi/pos android",
    "sync:dev": "pnpm --filter @kaissi/sync dev",
    "sync:appairer": "node --experimental-strip-types --import ./apps/sync/scripts/charger-ts.mjs apps/sync/scripts/appairer.mjs",
    "sync:reprojeter": "node --experimental-strip-types --import ./apps/sync/scripts/charger-ts.mjs apps/sync/scripts/reprojeter.mjs",
    "sync:cles": "node apps/sync/scripts/cles-vapid.mjs",
    "sync:acces": "node --experimental-strip-types --import ./apps/sync/scripts/charger-ts.mjs apps/sync/scripts/acces.mjs",
    "backoffice:dev": "pnpm --filter @kaissi/backoffice dev",
    "verifier:natif": "pnpm --filter @kaissi/pos verifier:natif",
    "verifier:avion": "pnpm --filter @kaissi/pos verifier:avion",
    "parcours": "pnpm --filter @kaissi/pos test:parcours",
    "persistance": "pnpm --filter @kaissi/pos test:persistance",
    "imprimante": "node apps/pos/scripts/imprimante-virtuelle.mjs"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "@types/node": "^22.13.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
