{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [
      "vite/client"
    ],
    "noEmit": true,
    "paths": {
      "@kaissi/domain": [
        "../../packages/domain/src/index.ts"
      ],
      "@kaissi/db-local": [
        "../../packages/db-local/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "capacitor.config.ts"
  ]
}
