{
  "name": "@kaissi/pos",
  "version": "0.1.0",
  "private": true,
  "description": "Terminal de caisse Kaissi — Vite + React empaqueté dans Capacitor. Fonctionne en mode avion.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "VITE_CIBLE=web vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && node scripts/verifier-mode-avion.mjs",
    "build:web": "tsc -p tsconfig.json --noEmit && VITE_CIBLE=web vite build && node scripts/verifier-mode-avion.mjs",
    "preview": "vite preview",
    "preview:web": "VITE_CIBLE=web vite preview --port 4173",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cap:sync": "pnpm build && cap sync android",
    "android:add": "cap add android",
    "android:open": "cap open android",
    "android": "pnpm cap:sync && cap run android",
    "verifier:avion": "node scripts/verifier-mode-avion.mjs",
    "verifier:natif": "node scripts/verifier-plugin-natif.mjs",
    "test:parcours": "node tests/parcours-caisse.mjs",
    "test:persistance": "node tests/persistance-web.mjs"
  },
  "dependencies": {
    "@kaissi/domain": "workspace:*",
    "@kaissi/db-local": "workspace:*",
    "@capacitor/core": "^7.0.1",
    "@capacitor/android": "^7.0.1",
    "@capacitor/app": "^7.0.0",
    "@capacitor/network": "^7.0.0",
    "@capacitor-community/sqlite": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@kaissi/printing": "workspace:*",
    "@kaissi/sync-client": "workspace:*"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "sql.js": "^1.12.0",
    "@types/sql.js": "^1.4.9",
    "playwright": "^1.50.1"
  }
}
