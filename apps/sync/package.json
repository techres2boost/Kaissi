{
  "name": "@kaissi/sync",
  "version": "0.1.0",
  "private": true,
  "description": "API de synchronisation Kaissi — Hono sur Node. Push idempotent, pull par curseur.",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --experimental-strip-types --import ./scripts/charger-ts.mjs src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node --env-file-if-exists=.env --experimental-strip-types --import ./scripts/charger-ts.mjs src/index.ts"
  },
  "dependencies": {
    "@kaissi/domain": "workspace:*",
    "hono": "^4.6.20",
    "@hono/node-server": "^1.13.8",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "@types/pg": "^8.11.10"
  }
}
